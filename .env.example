# Copy to .env for local runs (docker compose reads it automatically)
# docker compose
POSTGRES_PASSWORD=change-me

# running without docker compose
DATABASE_URL=postgresql://user:password@localhost:5432/berlin_stats
SECRET_PASSWORD=change-me

# Optional
POLL_INTERVAL_HOURS=24
POLL_ON_STARTUP=true
CORS_ORIGINS=*
ROOT_PATH=
